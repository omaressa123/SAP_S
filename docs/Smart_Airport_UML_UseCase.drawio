<mxfile host="app.diagrams.net"><diagram id="uc1" name="Use Case"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;SMART AIRPORT — UML Use Case Diagram&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Derived from the business model: actors from lanes 1, 3, 4, 5; use cases from the 7 journey steps&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="40" as="geometry"/></mxCell><mxCell id="sys" value="Smart Airport System" style="rounded=0;html=1;fillColor=none;strokeColor=#444441;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="50" width="665" height="800" as="geometry"/></mxCell><mxCell id="u0" value="Login" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="285" y="90" width="250" height="48" as="geometry"/></mxCell><mxCell id="u1" value="View flight information" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="285" y="162" width="250" height="48" as="geometry"/></mxCell><mxCell id="u2" value="Scan passport" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="285" y="234" width="250" height="48" as="geometry"/></mxCell><mxCell id="u3" value="Verify face" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="285" y="306" width="250" height="48" as="geometry"/></mxCell><mxCell id="u4" value="Check in" style="ellipse;whiteSpace=wrap;html=1;fillC