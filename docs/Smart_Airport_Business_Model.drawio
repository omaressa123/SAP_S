        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#534AB7;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#534AB7;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#534AB7;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#534AB7;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#534AB7;endArrow=block;endFill=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="xa" value="flights, bookings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#5F5E5A;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="airline" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="xb" value="passport rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#5F5E5A;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="border" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="st1" value="&lt;b&gt;Check-in staff&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Helps if ID fails&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;" vertex="1" parent="1">
