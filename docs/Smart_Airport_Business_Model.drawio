        </mxCell>

        <mxCell id="y1" value="&lt;b&gt;AI system&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Face, OCR, X-ray, falls&lt;br&gt;(assists humans)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#4A1B0C;fontSize=13;" vertex="1" parent="1">
