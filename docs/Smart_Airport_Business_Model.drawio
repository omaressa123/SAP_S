<mxfile host="app.diagrams.net">
  <diagram id="bm1" name="Business Model">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;SMART AIRPORT — Business Model&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;The passenger journey is the center. People and systems exist to support it.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="laneA" value="1. EXTERNAL ACTORS (outside the airport)" style="rounded=1;arcSize=3;fillColor=#F7F6F2;strokeColor=#B4B2A9;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#444441;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="1330" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="laneB" value="2. PRIMARY BUSINESS PROCESS — THE PASSENGER JOURNEY" style="rounded=1;arcSize=3;fillColor=#F6F5FF;strokeColor=#AFA9EC;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#3C3489;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="1330" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="laneC" value="3. AIRPORT STAFF (who works at each step)" style="rounded=1;arcSize=3;fillColor=#F2FBF8;strokeColor=#5DCAA5;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#085041;" vertex="1" parent="1">
          <mxGeometry x="20" y="370" width="1330" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="laneD" value="4. MANAGEMENT AND SUPPORT TEAMS (oversee all steps)" style="rounded=1;arcSize=3;fillColor=#F2FBF8;strokeColor=#5DCAA5;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#085041;" vertex="1" parent="1">
          <mxGeometry x="20" y="500" width="1330" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="laneE" value="5. SUPPORTING SYSTEMS (technology behind every step)" style="rounded=1;arcSize=3;fillColor=#FEF6F3;strokeColor=#F0997B;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#712B13;" vertex="1" parent="1">
          <mxGeometry x="20" y="630" width="1330" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="airline" value="&lt;b&gt;Airline&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Provides flights and bookings&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="105" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="border" value="&lt;b&gt;Border control / Government&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Sets passport rules&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="105" width="210" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="pax" value="&lt;b&gt;PASSENGER&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Mobile app user&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#534AB7;strokeColor=#26215C;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="240" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Entry&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Arrive, open app,&lt;br&gt;see flight info&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="190" y="240" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Check-in &amp;amp; ID&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Passport scan,&lt;br&gt;face verification&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="354" y="240" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Baggage&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Drop, tag, track,&lt;br&gt;X-ray check&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="518" y="240" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Security&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;AI assists,&lt;br&gt;officer decides&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="682" y="240" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Smart gate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Verify boarding pass,&lt;br&gt;board aircraft&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="846" y="240" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. Flight&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Ground operations&lt;br&gt;monitored&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1010" y="240" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;7. Arrival &amp;amp; exit&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Claim bag, exit,&lt;br&gt;journey completed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1174" y="240" width="140" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#534AB7;endArrow=block;endFill=1;" edge="1" parent="1" source="pax" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
