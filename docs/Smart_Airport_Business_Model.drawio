        <mxCell id="st2" value="&lt;b&gt;Baggage staff&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Inspects flagged bags&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;" vertex="1" parent="1">
