        <mxCell id="st4" value="&lt;b&gt;Gate staff&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Handles boarding issues&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="846" y="405" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="st5" value="&lt;b&gt;Ground staff&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Aircraft parking, service&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1010" y="405" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="es1" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#0F6E56;endArrow=block;endFill=1;" edge="1" parent="1" source="st1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es2" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#0F6E56;endArrow=block;endFill=1;" edge="1" parent="1" source="st2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es3" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#0F6E56;endArrow=block;endFill=1;" edge="1" parent="1" source="st3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es4" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#0F6E56;endArrow=block;endFill=1;" edge="1" parent="1" source="st4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es5" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#0F6E56;endArrow=block;endFill=1;" edge="1" parent="1" source="st5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="m1" value="&lt;b&gt;Airport management&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Flights, gates, policy&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="190" y="535" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;IT administrator&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Network, servers, accounts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="535" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;Maintenance team&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Repairs equipment faults&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;" vertex="1" parent="1">
