        <mxCell id="st3" value="&lt;b&gt;Security officer&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Final human decision&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="682" y="405" width="140" height="60" as="geometry"/>
