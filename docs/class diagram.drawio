        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass User {\n  -id: Long\n  -fullName: String\n  -email: String\n  -passwordHash: String\n  -role: String\n  -status: String\n  +login(pwd: String): boolean\n  +logout(): void\n  +changePwd(pwd: String): boolean\n}\nclass Passenger {\n  -nationality: String\n  -dateOfBirth: LocalDate\n  -biometricConsent: Boolean\n  -needsStepFree: Boolean\n  +verifyIdentity(): boolean\n  +getBookings(): List\n}\nclass Staff {\n  -employeeId: String\n  -department: String\n  -jobRole: String\n  -shift: String\n  +getAssignedTasks(): List\n  +handleCase(caseId: Long): void\n}\nclass Passport {\n  -id: Long\n  -number: String\n  -issuingCountry: String\n  -expiryDate: LocalDate\n  +isExpired(): boolean\n  +matchesBooking(bookingId: Long): boolean\n}\nclass FaceTemplate {\n  -id: Long\n  -encodedData: String\n  -createdAt: LocalDateTime\n  -expiresAt: LocalDateTime\n  +compare(liveFace: String): Double\n  +purge(): void\n}\nclass Booking {\n  -id: Long\n  -bookingRef: String\n  -seatNumber: String\n  -checkInStatus: String\n  +checkIn(): BoardingPass\n  +cancel(): void\n}\nclass CheckInRecord {\n  -id: Long\n  -status: String\n  -faceMatchScore: Double\n  -completedAt: LocalDateTime\n  +verifyIdentity(): boolean\n  +complete(): BoardingPass\n  +escalateToStaff(): void\n}\nclass BoardingPass {\n  -id: Long\n  -qrCode: String\n  -issuedAt: LocalDateTime\n  -status: String\n  +validate(): boolean\n  +markBoarded(): void\n}\nclass Baggage {\n  -id: Long\n  -tagCode: String\n  -weightKg: Double\n  -status: String\n  -lastLocation: String\n  +updateStatus(s: String): void\n  +track(): String\n}\nclass ScreeningResult {\n  -id: Long\n  -decision: String\n  -aiConfidence: Double\n  -screenedAt: LocalDateTime\n  +flagForInspection(): void\n  +clear(): void\n  +escalate(): void\n}\nclass Flight {\n  -id: Long\n  -flightNumber: String\n  -destination: String\n  -departureTime: LocalDateTime\n  -status: String\n  +updateStatus(status: String): void\n  +assignGate(gate: Gate): void\n  +isBoardingOpen(): boolean\n}\nclass Gate {\n  -id: Long\n  -code: String\n  -status: String\n  -isSmartGate: Boolean\n  +open(): void\n  +isAvailable(): boolean\n}\nclass Terminal {\n  -id: Long\n  -name: String\n  -floors: Integer\n  -status: String\n  +getGates(): List\n  +getDeviceCount(): int\n}\nclass IoTDevice {\n  -id: Long\n  -type: String\n  -location: String\n  -status: String\n  -lastUpdate: LocalDateTime\n  +reportStatus(): String\n  +sendData(): SensorData\n}\nclass SmartGate {\n  -mode: String\n  -lastScanAt: LocalDateTime\n  -boardedCount: Integer\n  +verifyBoarding(qr: String): boolean\n  +open(): void\n  +close(): void\n}\nclass SensorData {\n  -id: Long\n  -value: Double\n  -unit: String\n  -recordedAt: LocalDateTime\n  +isAbnormal(): boolean\n  +getLatest(): SensorData\n}\nclass SecurityIncident {\n  -id: Long\n  -type: String\n  -status: String\n  -detectedAt: LocalDateTime\n  +assignStaff(staff: Staff): void\n  +close(report: String): void\n}\nclass MaintenanceTicket {\n  -id: Long\n  -symptom: String\n  -priority: String\n  -status: String\n  +assign(staff: Staff): void\n  +escalate(): void\n  +close(notes: String): void\n}\n\n%% Inheritance\nUser &lt;|-- Passenger\nUser &lt;|-- Staff\nIoTDevice &lt;|-- SmartGate\n\n%% Composition\nPassenger \&quot;1\&quot; *-- \&quot;0..1\&quot; FaceTemplate : has\nBooking \&quot;1\&quot; *-- \&quot;0..1\&quot; BoardingPass : issues\nTerminal \&quot;1\&quot; *-- \&quot;1..*\&quot; Gate : contains\nIoTDevice \&quot;1\&quot; *-- \&quot;0..*\&quot; SensorData : emits\n\n%% Aggregation\nTerminal \&quot;1\&quot; o-- \&quot;0..*\&quot; IoTDevice : hosts\n\n%% Associations\nPassenger \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Passport : owns\nPassenger \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Booking : makes\nBooking \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Flight : is for\nBooking \&quot;1\&quot; --&gt; \&quot;0..1\&quot; CheckInRecord : checked in by\nPassport \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CheckInRecord : used in\nBooking \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Baggage : carries\nBaggage \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ScreeningResult : screened by\nStaff \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ScreeningResult : decides\nStaff \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; SecurityIncident : handles\nStaff \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; MaintenanceTicket : fixes\nFlight \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Gate : departs from\nGate \&quot;1\&quot; --&gt; \&quot;0..1\&quot; SmartGate : equipped with\nIoTDevice \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; SecurityIncident : detects\nIoTDevice \&quot;1\&quot; --&gt; \&quot;0..*\&quot; MaintenanceTicket : has&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="pk3NNsVd-EiouBKT3Aic-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
