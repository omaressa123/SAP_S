      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass User {\n  -Long id PK\n  -String fullName\n  -String email UNIQUE\n  -String passwordHash\n  -String role\n  -String status\n  +login() boolean\n  +logout() void\n  +changePassword(String newPwd) boolean\n}\nclass Passenger {\n  -Long userId PK_FK\n  -String passportNumber\n  -String nationality\n  -LocalDate dateOfBirth\n  -Boolean biometricConsent\n  +verifyIdentity() boolean\n  +getBookings() List\n}\nclass Staff {\n  -Long userId PK_FK\n  -String employeeId UNIQUE\n  -String department\n  -String jobRole\n  -String shift\n  +getAssignedTasks() List\n  +handleCase(Long caseId) void\n}\nclass Booking {\n  -Long bookingId PK\n  -String bookingRef UNIQUE\n  -String seatNumber\n  -String checkInStatus\n  -Long passengerId FK\n  -Long flightId FK\n  +checkIn() BoardingPass\n  +cancel() void\n}\nclass BoardingPass {\n  -Long passId PK\n  -String qrCode\n  -LocalDateTime issuedAt\n  -String status\n  -Long bookingId FK\n  +validate() boolean\n  +markBoarded() void\n}\nclass Baggage {\n  -Long bagId PK\n  -String tagCode UNIQUE\n  -Double weightKg\n  -String status\n  -String lastLocation\n  -Long bookingId FK\n  +updateStatus(String status, String location) void\n  +track() String\n}\nclass Flight {\n  -Long flightId PK\n  -String flightNumber UNIQUE\n  -String destination\n  -LocalDateTime departureTime\n  -String status\n  -Long gateId FK\n  +updateStatus(String status) void\n  +assignGate(Long gateId) void\n  +isBoardingOpen() boolean\n}\nclass Gate {\n  -Long gateId PK\n  -String code\n  -String status\n  -Boolean isSmartGate\n  -Long terminalId FK\n  +open() void\n  +isAvailable() boolean\n}\nclass Terminal {\n  -Long terminalId PK\n  -String name\n  -Integer floors\n  -String status\n  +getGates() List\n  +getDeviceCount() int\n}\nclass IoTDevice {\n  -Long deviceId PK\n  -String type\n  -String location\n  -String status\n  -LocalDateTime lastUpdate\n  -Long terminalId FK\n  +reportStatus() String\n  +sendData() SensorData\n}\nclass SensorData {\n  -Long dataId PK\n  -Double value\n  -String unit\n  -LocalDateTime recordedAt\n  -Long deviceId FK\n  +isAbnormal() boolean\n  +getLatest() SensorData\n}\nclass SecurityIncident {\n  -Long incidentId PK\n  -String type\n  -String status\n  -LocalDateTime detectedAt\n  -Long deviceId FK\n  -Long staffId FK\n  +assignStaff(Long staffId) void\n  +close(String report) void\n}\n\nUser &lt;|-- Passenger\nUser &lt;|-- Staff\n\nPassenger \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Booking : makes\nBooking \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Flight : is for\nBooking \&quot;1\&quot; *-- \&quot;0..1\&quot; BoardingPass : issues\nBooking \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Baggage : carries\n\nFlight \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Gate : departs from\nTerminal \&quot;1\&quot; *-- \&quot;1..*\&quot; Gate : contains\nTerminal \&quot;1\&quot; o-- \&quot;0..*\&quot; IoTDevice : hosts\n\nIoTDevice \&quot;1\&quot; *-- \&quot;0..*\&quot; SensorData : generates\nIoTDevice \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; SecurityIncident : detects\nStaff \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; SecurityIncident : handles\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="uMX3YgkjVvdXq4vOMCxr-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
