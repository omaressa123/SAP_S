        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass User {\n  -id: Long «PK»\n  -fullName: String\n  -email: String «unique»\n  -passwordHash: String\n  -role: String\n  -status: String\n  +login(): boolean\n  +logout(): void\n  +changePwd(pwd: String): boolean\n}\nclass Passenger {\n  -userId: Long «PK, FK»\n  -nationality: String\n  -dateOfBirth: LocalDate\n  -biometricConsent: Boolean\n  -needsStepFree: Boolean\n  +verifyIdentity(): boolean\n  +getBookings(): List\n}\nclass Staff {\n  -userId: Long «PK, FK»\n  -employeeId: String «unique»\n  -department: String\n  -jobRole: String\n  -shift: String\n  +getAssignedTasks(): List\n  +handleCase(caseId: Long): void\n}\nclass Passport {\n  -passportId: Long «PK»\n  -number: String «unique»\n  -issuingCountry: String\n  -expiryDate: LocalDate\n  -passengerId: Long «FK»\n  +isExpired(): boolean\n  +matchesBooking(id: Long): boolean\n}\nclass FaceTemplate {\n  -faceId: Long «PK»\n  -encodedData: String\n  -createdAt: LocalDateTime\n  -expiresAt: LocalDateTime\n  -passengerId: Long «FK»\n  +compare(liveFace: String): Double\n  +purge(): void\n}\nclass Booking {\n  -bookingId: Long «PK»\n  -bookingRef: String «unique»\n  -seatNumber: String\n  -checkInStatus: String\n  -passengerId: Long «FK»\n  -flightId: Long «FK»\n  +checkIn(): BoardingPass\n  +cancel(): void\n}\nclass CheckInRecord {\n  -checkInId: Long «PK»\n  -status: String\n  -faceMatchScore: Double\n  -completedAt: LocalDateTime\n  -bookingId: Long «FK»\n  -passportId: Long «FK»\n  +verifyIdentity(): boolean\n  +complete(): BoardingPass\n  +escalateToStaff(): void\n}\nclass BoardingPass {\n  -passId: Long «PK»\n  -qrCode: String\n  -issuedAt: LocalDateTime\n  -status: String\n  -bookingId: Long «FK»\n  +validate(): boolean\n  +markBoarded(): void\n}\nclass Baggage {\n  -bagId: Long «PK»\n  -tagCode: String «unique»\n  -weightKg: Double\n  -status: String\n  -lastLocation: String\n  -bookingId: Long «FK»\n  +updateStatus(s: String): void\n  +track(): String\n}\nclass ScreeningResult {\n  -screeningId: Long «PK»\n  -decision: String\n  -aiConfidence: Double\n  -screenedAt: LocalDateTime\n  -bagId: Long «FK»\n  -officerId: Long «FK»\n  +flagForInspection(): void\n  +clear(): void\n  +escalate(): void\n}\nclass Flight {\n  -flightId: Long «PK»\n  -flightNumber: String «unique»\n  -destination: String\n  -departureTime: LocalDateTime\n  -status: String\n  -gateId: Long «FK»\n  +updateStatus(status: String): void\n  +assignGate(gateId: Long): void\n  +isBoardingOpen(): boolean\n}\nclass Gate {\n  -gateId: Long «PK»\n  -code: String\n  -status: String\n  -isSmartGate: Boolean\n  -terminalId: Long «FK»\n  +open(): void\n  +isAvailable(): boolean\n}\nclass Terminal {\n  -terminalId: Long «PK»\n  -name: String\n  -floors: Integer\n  -status: String\n  +getGates(): List\n  +getDeviceCount(): int\n}\nclass IoTDevice {\n  -deviceId: Long «PK»\n  -type: String\n  -location: String\n  -status: String\n  -lastUpdate: LocalDateTime\n  -terminalId: Long «FK»\n  +reportStatus(): String\n  +sendData(): SensorData\n}\nclass SmartGate {\n  -deviceId: Long «PK, FK»\n  -gateId: Long «FK»\n  -mode: String\n  -lastScanAt: LocalDateTime\n  -boardedCount: Integer\n  +verifyBoarding(qr: String): boolean\n  +open(): void\n  +close(): void\n}\nclass SensorData {\n  -dataId: Long «PK»\n  -value: Double\n  -unit: String\n  -recordedAt: LocalDateTime\n  -deviceId: Long «FK»\n  +isAbnormal(): boolean\n  +getLatest(): SensorData\n}\nclass SecurityIncident {\n  -incidentId: Long «PK»\n  -type: String\n  -status: String\n  -detectedAt: LocalDateTime\n  -deviceId: Long «FK»\n  -staffId: Long «FK»\n  +assignStaff(staffId: Long): void\n  +close(report: String): void\n}\nclass MaintenanceTicket {\n  -ticketId: Long «PK»\n  -symptom: String\n  -priority: String\n  -status: String\n  -deviceId: Long «FK»\n  -technicianId: Long «FK»\n  +assign(staffId: Long): void\n  +escalate(): void\n  +close(notes: String): void\n}\n\nUser &lt;|-- Passenger\nUser &lt;|-- Staff\nIoTDevice &lt;|-- SmartGate\n\nPassenger \&quot;1\&quot; *-- \&quot;0..1\&quot; FaceTemplate : has\nPassenger \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Passport : owns\nPassenger \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Booking : makes\n\nBooking \&quot;1\&quot; --&gt; \&quot;0..1\&quot; CheckInRecord : checked in by\nPassport \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CheckInRecord : used in\nBooking \&quot;1\&quot; *-- \&quot;0..1\&quot; BoardingPass : issues\nBooking \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Baggage : carries\nBooking \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Flight : is for\n\nBaggage \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; ScreeningResult : checked\nStaff \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ScreeningResult : decides\nStaff \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; SecurityIncident : handles\nStaff \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; MaintenanceTicket : fixes\n\nFlight \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Gate : uses\nTerminal \&quot;1\&quot; *-- \&quot;1..*\&quot; Gate : part of\nGate \&quot;1\&quot; --&gt; \&quot;0..1\&quot; SmartGate : equipped\n\nTerminal \&quot;1\&quot; o-- \&quot;0..*\&quot; IoTDevice : hosts\nIoTDevice \&quot;1\&quot; *-- \&quot;0..*\&quot; SensorData : emits\nIoTDevice \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; SecurityIncident : detects\nIoTDevice \&quot;1\&quot; --&gt; \&quot;0..*\&quot; MaintenanceTicket : has\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="UEsdH7QKymcxvP4-X16X-1">
