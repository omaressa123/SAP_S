<mxfile host="app.diagrams.net" pages="5">
  <diagram id="8Gc3rWX0O0NQpirWqQL1" name="Page-7">
    <mxGraphModel dx="2044" dy="1128" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\n%% ===================== ENUMERATIONS =====================\nclass AccountStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  ACTIVE\n  LOCKED\n  DISABLED\n  PENDING_VERIFICATION\n}\nclass FlightStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  SCHEDULED\n  BOARDING\n  GATE_CLOSED\n  DEPARTED\n  LANDED\n  DELAYED\n  CANCELLED\n}\nclass CheckInStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  NOT_STARTED\n  IN_PROGRESS\n  MANUAL_REVIEW\n  COMPLETED\n  REJECTED\n}\nclass BaggageStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  REGISTERED\n  SCREENING\n  UNDER_INSPECTION\n  SORTED\n  LOADED\n  UNLOADED\n  ON_BELT\n  CLAIMED\n  DELAYED\n  MISSING\n}\nclass ScreeningDecision {\n  &lt;&lt;enumeration&gt;&gt;\n  CLEAR\n  STOP\n  MANUAL_SEARCH\n}\nclass BorderDecisionType {\n  &lt;&lt;enumeration&gt;&gt;\n  APPROVED\n  REFUSED\n  REFERRED\n}\nclass NotificationChannel {\n  &lt;&lt;enumeration&gt;&gt;\n  PUSH\n  SMS\n  SCREEN\n  IN_APP_INBOX\n}\nclass IncidentType {\n  &lt;&lt;enumeration&gt;&gt;\n  FALL\n  CROWD\n  FIRE\n  MANUAL\n  DEVICE_FAULT\n}\nclass IncidentStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  OPEN\n  ACCEPTED\n  ON_SCENE\n  RESOLVED\n  FALSE_ALARM\n}\nclass TicketPriority {\n  &lt;&lt;enumeration&gt;&gt;\n  LOW\n  MEDIUM\n  HIGH\n  CRITICAL\n}\nclass TicketStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  OPEN\n  ASSIGNED\n  IN_PROGRESS\n  WAITING_PART\n  CLOSED\n}\nclass DeviceStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  ONLINE\n  OFFLINE\n  FAULTY\n  STALE\n}\n\n%% ===================== USERS AND SECURITY (ENTITIES) =====================\nclass User {\n  &lt;&lt;abstract&gt;&gt;\n  #String userId\n  #String fullName\n  #String email\n  #String phone\n  #String passwordHash\n  #AccountStatus status\n  #int failedAttempts\n  #DateTime lockedUntil\n  #DateTime createdAt\n  +login(String credential, String password) Session\n  +logout() void\n  +changePassword(String oldPwd, String newPwd) boolean\n  +isLocked() boolean\n}\nclass Passenger {\n  -String preferredLanguage\n  -boolean needsStepFree\n  -boolean biometricConsent\n  -boolean pushEnabled\n  +register(String name, String contact, String password) Passenger\n  +verifyContact(String code) boolean\n  +acceptPrivacyNotice() void\n  +linkBooking(String bookingRef) Booking\n}\nclass Staff {\n  &lt;&lt;abstract&gt;&gt;\n  #String employeeId\n  #String department\n  #String shift\n  +getDashboard() Dashboard\n}\nclass CheckInStaff {\n  +reviewIdFailure(String checkInId) IdVerification\n  +approveManual(String checkInId, boolean approved, String note) void\n}\nclass GateStaff {\n  +resolveBoardingIssue(String boardingId, String action) void\n  +openManualLane(String gateId) void\n}\nclass BaggageStaff {\n  +printTagManually(String bagId) BaggageTag\n  +openMissingBagCase(String bagId) void\n}\nclass SecurityOfficer {\n  +reviewScreening(String screeningId) ScreeningResult\n  +decide(String screeningId, ScreeningDecision decision) void\n}\nclass EmergencyTeamMember {\n  -boolean isTeamLeader\n  +acceptIncident(String incidentId) void\n  +assignResponders(String incidentId, List~String~ staffIds) void\n  +closeIncident(String incidentId, String report) void\n}\nclass MaintenanceTechnician {\n  +takeTicket(String ticketId) void\n  +closeTicket(String ticketId, String notes) void\n}\nclass AdminUser {\n  +manageAccount(String userId, String action) void\n}\nclass ManagementUser {\n  +viewReports(DateTime from, DateTime to) Report\n}\nclass Role {\n  -String roleId\n  -String name\n  +hasPermission(String code) boolean\n}\nclass Permission {\n  -String permissionId\n  -String code\n  -String description\n}\nclass Session {\n  -String sessionId\n  -DateTime startedAt\n  -DateTime lastActivity\n  -DateTime expiresAt\n  +isExpired() boolean\n  +touch() void\n}\nclass AuditLog {\n  -String logId\n  -String action\n  -String details\n  -DateTime timestamp\n}\n\n%% ===================== FLIGHT AND AIRPORT STRUCTURE (ENTITIES) =====================\nclass Airline {\n  -String airlineId\n  -String name\n  -String code\n  -String rebookingContact\n}\nclass Flight {\n  -String flightId\n  -String flightNumber\n  -String origin\n  -String destination\n  -DateTime departureTime\n  -DateTime arrivalTime\n  -FlightStatus status\n  -boolean isInternational\n  -int boardedCount\n  +updateStatus(FlightStatus s) void\n  +incrementBoarded() void\n  +isCheckInOpen() boolean\n}\nclass Terminal {\n  -String terminalId\n  -String name\n}\nclass Gate {\n  -String gateId\n  -String code\n  -boolean isOpen\n}\nclass AircraftStand {\n  -String standId\n  -String code\n}\nclass BaggageBelt {\n  -String beltId\n  -String number\n}\nclass Booking {\n  -String bookingId\n  -String bookingRef\n  -String passengerName\n  -String seatNumber\n  -int allowedBags\n  -double allowedWeightKg\n  -boolean checkedIn\n  +isValid() boolean\n}\n\n%% ===================== CHECK-IN AND IDENTITY (ENTITIES) =====================\nclass CheckIn {\n  -String checkInId\n  -CheckInStatus status\n  -DateTime startedAt\n  -DateTime completedAt\n}\nclass BoardingPass {\n  -String passId\n  -String qrCode\n  -String seat\n  -DateTime issuedAt\n  -boolean valid\n  +isValidFor(String flightId, String gateId) boolean\n}\nclass Passport {\n  -String passportId\n  -String number\n  -String surname\n  -String givenNames\n  -String nationality\n  -Date dateOfBirth\n  -Date expiryDate\n  -byte photo\n  +isExpired() boolean\n  +matchesBooking(Booking b) boolean\n}\nclass IdVerification {\n  -String verificationId\n  -double faceMatchScore\n  -boolean livenessPassed\n  -int attempts\n  -boolean manualOverride\n  -String decidedByStaffId\n  -DateTime decidedAt\n}\nclass FaceTemplate {\n  -String templateId\n  -byte encodedTemplate\n  -DateTime createdAt\n  -DateTime expiresAt\n  +purge() void\n}\n\n%% ===================== BAGGAGE (ENTITIES) =====================\nclass Baggage {\n  -String bagId\n  -double weightKg\n  -BaggageStatus status\n  -String lastLocation\n  -DateTime lastScanTime\n  +updateStatus(BaggageStatus s, String location) void\n  +isDelayed() boolean\n}\nclass BaggageTag {\n  -String tagId\n  -String barcode\n  -String rfid\n  -DateTime printedAt\n}\nclass BaggageEvent {\n  -String eventId\n  -String eventType\n  -String location\n  -DateTime scannedAt\n}\nclass BagInspection {\n  -String inspectionId\n  -String result\n  -boolean passengerPresent\n  -DateTime inspectedAt\n}\n\n%% ===================== SECURITY AND BOARDING (ENTITIES) =====================\nclass ScreeningResult {\n  -String screeningId\n  -ScreeningDecision decision\n  -DateTime screenedAt\n  -String note\n}\nclass ThreatFinding {\n  -String findingId\n  -String itemType\n  -double confidence\n  -String boundingBox\n  -boolean confirmedByOfficer\n}\nclass BoardingRecord {\n  -String boardingId\n  -DateTime boardedAt\n  -boolean success\n  -String failureReason\n}\nclass BorderDecision {\n  -String decisionId\n  -BorderDecisionType decision\n  -DateTime decidedAt\n  -String officerId\n  -String reason\n}\n\n%% ===================== NOTIFICATIONS =====================\nclass NotificationTemplate {\n  -String templateId\n  -String eventType\n  -String body\n}\nclass Notification {\n  -String notificationId\n  -String message\n  -NotificationChannel channel\n  -boolean isEmergency\n  -boolean isRead\n  -DateTime sentAt\n  -DateTime deliveredAt\n  +markAsRead() void\n}\n\n%% ===================== IOT, ZONES, DIGITAL TWIN, INCIDENTS, MAINTENANCE =====================\nclass Zone {\n  -String zoneId\n  -String name\n  -int crowdLimit\n  -int currentDensity\n}\nclass IoTDevice {\n  &lt;&lt;abstract&gt;&gt;\n  #String deviceId\n  #String type\n  #String location\n  #DeviceStatus status\n  #DateTime lastUpdate\n  +reportStatus() DeviceStatus\n}\nclass Camera {\n  -String streamUrl\n  -boolean blocked\n  +getSnapshot() byte\n}\nclass Beacon {\n  -String uuid\n  -int txPower\n}\nclass XRayScanner {\n  +captureImage() byte\n}\nclass SmartGate {\n  +open() void\n  +close() void\n  +readQr() String\n}\nclass Kiosk {\n  -boolean chipReaderAvailable\n  +scanDocument() byte\n}\nclass Incident {\n  -String incidentId\n  -IncidentType type\n  -IncidentStatus status\n  -double confidence\n  -String snapshotRef\n  -String report\n  -DateTime detectedAt\n  -DateTime closedAt\n}\nclass IncidentUpdate {\n  -String updateId\n  -IncidentStatus newStatus\n  -String note\n  -DateTime timestamp\n}\nclass MaintenanceTicket {\n  -String ticketId\n  -String symptom\n  -TicketPriority priority\n  -TicketStatus status\n  -DateTime createdAt\n  -DateTime closedAt\n}\nclass DigitalTwin {\n  -String twinId\n  -String modelVersion\n  -DateTime lastSync\n  +refresh() void\n  +getZoneState(String zoneId) Zone\n}\nclass IndoorMap {\n  -String mapId\n  -int floor\n}\nclass NavigationRoute {\n  -String routeId\n  -double distanceM\n  -int walkingTimeMin\n  -boolean stepFree\n}\n\n%% ===================== SERVICES / CONTROLLERS =====================\nclass AuthService {\n  +register(String name, String contact, String password) Passenger\n  +login(String credential, String password) Session\n  +logout(String sessionId) void\n  +verifyCode(String contact, String code) boolean\n  +checkPermission(String userId, String permissionCode) boolean\n  +writeAudit(String userId, String action) void\n}\nclass UserManagementService {\n  +createUser(User u, String roleId) User\n  +updateUser(String userId, User data) User\n  +disableUser(String userId) void\n  +assignRole(String userId, String roleId) void\n}\nclass FlightService {\n  +getFlightsFor(String passengerId) List~Flight~\n  +searchByNumber(String flightNumber) Flight\n  +getStatus(String flightId) FlightStatus\n  +syncWithAirline(String flightId) Flight\n}\nclass FlightManagementService {\n  +addFlight(Flight f) Flight\n  +updateFlight(String flightId, DateTime time, String gateId) Flight\n  +detectConflicts(String gateId, DateTime time) List~Flight~\n  +cancelFlight(String flightId, String reason) void\n}\nclass NavigationService {\n  +locate(String passengerId) String\n  +calculateRoute(String from, String to, boolean stepFree) NavigationRoute\n  +updateRoute(String routeId) NavigationRoute\n}\nclass CheckInService {\n  +startCheckIn(String bookingId) CheckIn\n  +confirmBooking(String bookingRef) Booking\n  +assignSeat(String checkInId) String\n  +issueBoardingPass(String checkInId) BoardingPass\n  +escalateToManual(String checkInId, String reason) void\n}\nclass PassportOcrService {\n  &lt;&lt;AI&gt;&gt;\n  +scan(byte image) Passport\n  +readChip(String passportId) Passport\n  +isImageQualityOk(byte image) boolean\n}\nclass FaceVerificationService {\n  &lt;&lt;AI&gt;&gt;\n  +checkLiveness(byte frame) boolean\n  +compare(byte liveFace, byte passportPhoto) double\n  +createTemplate(String passengerId, byte face) FaceTemplate\n  +verifyAtGate(byte liveFace, String passengerId) double\n}\nclass BaggageService {\n  +register(String bookingId, double weight) Baggage\n  +printTag(String bagId) BaggageTag\n  +recordScan(String bagId, String eventType, String location) BaggageEvent\n  +getStatus(String bagId) BaggageStatus\n  +flagDelayed(String bagId) void\n  +matchWithPassenger(String bagId, String passengerId) boolean\n}\nclass ScreeningService {\n  +startScreening(String passengerId) ScreeningResult\n  +recordDecision(String screeningId, ScreeningDecision d, String officerId) void\n  +requestInspection(String bagId, String reason) BagInspection\n  +recordInspection(String inspectionId, String result) void\n}\nclass ThreatDetectionService {\n  &lt;&lt;AI&gt;&gt;\n  +analyze(byte xrayImage) List~ThreatFinding~\n  +requestRescan(String screeningId) void\n  +storeFeedback(String findingId, boolean confirmed) void\n}\nclass BoardingService {\n  +verifyBoarding(String qrCode, byte liveFace, String gateId) BoardingRecord\n  +handleIssue(String boardingId, String action) void\n  +recordBoarding(String passId) BoardingRecord\n}\nclass BorderControlGateway {\n  &lt;&lt;external&gt;&gt;\n  +submit(Passport p, Flight f) BorderDecision\n  +getDecision(String decisionId) BorderDecision\n  +isAvailable() boolean\n}\nclass NotificationService {\n  +sendEvent(String eventType, List~String~ recipientIds, Map data) void\n  +selectRecipients(String eventType, String targetId) List~User~\n  +deliver(Notification n) boolean\n  +retryOrFallback(Notification n) void\n  +sendEmergency(String message, String zoneId) void\n}\nclass IncidentDetectionService {\n  &lt;&lt;AI&gt;&gt;\n  +analyzeStream(String cameraId) Incident\n  +detectFall(byte frame) double\n  +detectCrowd(byte frame, int limit) double\n  +attachToOpenIncident(Incident i) boolean\n}\nclass EmergencyService {\n  +raiseIncident(Incident i) Incident\n  +raiseManual(String staffId, String location) Incident\n  +acceptAlert(String incidentId, String leaderId) void\n  +updateStatus(String incidentId, IncidentStatus s, String note) IncidentUpdate\n  +callExternalServices(String incidentId, String service) void\n  +close(String incidentId, String report) void\n}\nclass MaintenanceService {\n  +logFault(String deviceId, String symptom) MaintenanceTicket\n  +assign(String ticketId, String technicianId) void\n  +updateTicket(String ticketId, TicketStatus s) void\n  +escalate(String ticketId) void\n  +close(String ticketId) void\n}\nclass DigitalTwinService {\n  +load() DigitalTwin\n  +getLiveData(String zoneId) Zone\n  +filterByLayer(String layer) List~IoTDevice~\n}\n\n%% ===================== INHERITANCE =====================\nUser &lt;|-- Passenger\nUser &lt;|-- Staff\nStaff &lt;|-- CheckInStaff\nStaff &lt;|-- GateStaff\nStaff &lt;|-- BaggageStaff\nStaff &lt;|-- SecurityOfficer\nStaff &lt;|-- EmergencyTeamMember\nStaff &lt;|-- MaintenanceTechnician\nStaff &lt;|-- AdminUser\nStaff &lt;|-- ManagementUser\nIoTDevice &lt;|-- Camera\nIoTDevice &lt;|-- Beacon\nIoTDevice &lt;|-- XRayScanner\nIoTDevice &lt;|-- SmartGate\nIoTDevice &lt;|-- Kiosk\n\n%% ===================== USERS AND SECURITY =====================\nUser \&quot;*\&quot; --&gt; \&quot;1\&quot; Role : has\nRole \&quot;1\&quot; o-- \&quot;*\&quot; Permission : grants\nUser \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Session : opens\nUser \&quot;1\&quot; --&gt; \&quot;0..*\&quot; AuditLog : generates\nUser \&quot;1\&quot; --&gt; \&quot;1\&quot; AccountStatus\nUser \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Notification : receives\n\n%% ===================== FLIGHT AND AIRPORT STRUCTURE =====================\nAirline \&quot;1\&quot; o-- \&quot;*\&quot; Flight : operates\nTerminal \&quot;1\&quot; *-- \&quot;1..*\&quot; Gate : contains\nTerminal \&quot;1\&quot; *-- \&quot;*\&quot; BaggageBelt : contains\nFlight \&quot;*\&quot; --&gt; \&quot;0..1\&quot; Gate : departs from\nFlight \&quot;*\&quot; --&gt; \&quot;0..1\&quot; AircraftStand : uses\nFlight \&quot;*\&quot; --&gt; \&quot;0..1\&quot; BaggageBelt : arrival belt\nFlight \&quot;*\&quot; --&gt; \&quot;1\&quot; FlightStatus\nPassenger \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Booking : holds\nBooking \&quot;*\&quot; --&gt; \&quot;1\&quot; Flight : for\n\n%% ===================== CHECK-IN AND IDENTITY =====================\nBooking \&quot;1\&quot; --&gt; \&quot;0..1\&quot; CheckIn : checked in by\nCheckIn \&quot;1\&quot; *-- \&quot;0..1\&quot; BoardingPass : issues\nCheckIn \&quot;1\&quot; *-- \&quot;1\&quot; IdVerification : verified by\nCheckIn \&quot;1\&quot; --&gt; \&quot;1\&quot; CheckInStatus\nIdVerification \&quot;1\&quot; --&gt; \&quot;1\&quot; Passport : uses\nIdVerification \&quot;1\&quot; --&gt; \&quot;0..1\&quot; FaceTemplate : creates\nIdVerification \&quot;*\&quot; --&gt; \&quot;0..1\&quot; CheckInStaff : manual decision\nPassenger \&quot;1\&quot; --&gt; \&quot;0..1\&quot; FaceTemplate : biometric\nPassenger \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Passport : owns\n\n%% ===================== BAGGAGE =====================\nBooking \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Baggage : has\nBaggage \&quot;1\&quot; *-- \&quot;1\&quot; BaggageTag : tagged with\nBaggage \&quot;1\&quot; *-- \&quot;0..*\&quot; BaggageEvent : history\nBaggage \&quot;*\&quot; --&gt; \&quot;0..1\&quot; BaggageBelt : collected at\nBaggage \&quot;1\&quot; --&gt; \&quot;1\&quot; BaggageStatus\nBagInspection \&quot;*\&quot; --&gt; \&quot;1\&quot; Baggage : inspects\nBagInspection \&quot;*\&quot; --&gt; \&quot;1\&quot; BaggageStaff : performed by\nBagInspection \&quot;*\&quot; --&gt; \&quot;0..1\&quot; SecurityOfficer : escalated to\n\n%% ===================== SECURITY SCREENING AND BOARDING =====================\nScreeningResult \&quot;*\&quot; --&gt; \&quot;1\&quot; Passenger : screens\nScreeningResult \&quot;*\&quot; --&gt; \&quot;0..*\&quot; Baggage : covers\nScreeningResult \&quot;1\&quot; *-- \&quot;0..*\&quot; ThreatFinding : contains\nScreeningResult \&quot;*\&quot; --&gt; \&quot;1\&quot; SecurityOfficer : decided by\nScreeningResult \&quot;1\&quot; --&gt; \&quot;1\&quot; ScreeningDecision\nScreeningResult \&quot;*\&quot; --&gt; \&quot;0..1\&quot; XRayScanner : scanned on\nBoardingRecord \&quot;*\&quot; --&gt; \&quot;1\&quot; BoardingPass : validates\nBoardingRecord \&quot;*\&quot; --&gt; \&quot;1\&quot; Gate : at\nBoardingRecord \&quot;*\&quot; --&gt; \&quot;0..1\&quot; GateStaff : handled by\nBorderDecision \&quot;*\&quot; --&gt; \&quot;1\&quot; Passenger : about\nBorderDecision \&quot;*\&quot; --&gt; \&quot;1\&quot; Flight : for\nBorderDecision \&quot;1\&quot; --&gt; \&quot;1\&quot; BorderDecisionType\n\n%% ===================== NOTIFICATIONS =====================\nNotification \&quot;*\&quot; --&gt; \&quot;1\&quot; NotificationTemplate : built from\nNotification \&quot;1\&quot; --&gt; \&quot;1\&quot; NotificationChannel\n\n%% ===================== ZONES, DEVICES, DIGITAL TWIN, INCIDENTS, MAINTENANCE =====================\nZone \&quot;1\&quot; o-- \&quot;*\&quot; IoTDevice : monitors\nGate \&quot;1\&quot; --&gt; \&quot;0..1\&quot; SmartGate : equipped with\nDigitalTwin \&quot;1\&quot; o-- \&quot;1..*\&quot; Zone : models\nDigitalTwin \&quot;1\&quot; o-- \&quot;*\&quot; IoTDevice : mirrors\nIndoorMap \&quot;1\&quot; o-- \&quot;*\&quot; Beacon : positioned by\nIndoorMap \&quot;1\&quot; --&gt; \&quot;1\&quot; Terminal : maps\nNavigationRoute \&quot;*\&quot; --&gt; \&quot;1\&quot; IndoorMap : drawn on\nNavigationRoute \&quot;*\&quot; --&gt; \&quot;1\&quot; Passenger : for\nIncident \&quot;1\&quot; *-- \&quot;1..*\&quot; IncidentUpdate : timeline\nIncident \&quot;*\&quot; --&gt; \&quot;1\&quot; Zone : located in\nIncident \&quot;*\&quot; --&gt; \&quot;0..1\&quot; Camera : detected by\nIncident \&quot;*\&quot; --&gt; \&quot;0..1\&quot; EmergencyTeamMember : led by\nIncident \&quot;1\&quot; --&gt; \&quot;1\&quot; IncidentType\nIncident \&quot;1\&quot; --&gt; \&quot;1\&quot; IncidentStatus\nMaintenanceTicket \&quot;*\&quot; --&gt; \&quot;1\&quot; IoTDevice : concerns\nMaintenanceTicket \&quot;*\&quot; --&gt; \&quot;0..1\&quot; MaintenanceTechnician : assigned to\nMaintenanceTicket \&quot;1\&quot; --&gt; \&quot;1\&quot; TicketPriority\nMaintenanceTicket \&quot;1\&quot; --&gt; \&quot;1\&quot; TicketStatus\nIoTDevice \&quot;1\&quot; --&gt; \&quot;1\&quot; DeviceStatus\n\n%% ===================== SERVICE DEPENDENCIES =====================\nAuthService ..&gt; User\nAuthService ..&gt; Session\nAuthService ..&gt; AuditLog\nUserManagementService ..&gt; User\nUserManagementService ..&gt; Role\nFlightService ..&gt; Flight\nFlightService ..&gt; Airline\nFlightManagementService ..&gt; Flight\nFlightManagementService ..&gt; Gate\nFlightManagementService ..&gt; NotificationService : includes\nNavigationService ..&gt; IndoorMap\nNavigationService ..&gt; NavigationRoute\nCheckInService ..&gt; Booking\nCheckInService ..&gt; CheckIn\nCheckInService ..&gt; PassportOcrService : includes\nCheckInService ..&gt; FaceVerificationService\nPassportOcrService ..&gt; Passport\nPassportOcrService ..&gt; FaceVerificationService : includes\nFaceVerificationService ..&gt; FaceTemplate\nFaceVerificationService ..&gt; IdVerification\nBaggageService ..&gt; Baggage\nBaggageService ..&gt; NotificationService\nScreeningService ..&gt; ScreeningResult\nScreeningService ..&gt; ThreatDetectionService : extends\nScreeningService ..&gt; BagInspection\nThreatDetectionService ..&gt; ThreatFinding\nBoardingService ..&gt; BoardingRecord\nBoardingService ..&gt; FaceVerificationService\nBoardingService ..&gt; BorderControlGateway : includes\nBorderControlGateway ..&gt; BorderDecision\nNotificationService ..&gt; Notification\nNotificationService ..&gt; NotificationTemplate\nIncidentDetectionService ..&gt; Incident\nIncidentDetectionService ..&gt; Camera\nEmergencyService ..&gt; IncidentDetectionService : includes\nEmergencyService ..&gt; NotificationService : includes\nEmergencyService ..&gt; Incident\nMaintenanceService ..&gt; MaintenanceTicket\nMaintenanceService ..&gt; IoTDevice\nDigitalTwinService ..&gt; DigitalTwin\nDigitalTwinService ..&gt; Zone\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="6xdwLMv3JOkRuOh6EPVC-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;AccountStatus&lt;/b&gt;" mermaidId="n:AccountStatus" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=66;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=#FDF4FF;whiteSpace=wrap;spacingTop=24;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;fontFamily=Recursive;strokeWidth=2;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;AccountStatus&lt;/b&gt;" id="6xdwLMv3JOkRuOh6EPVC-2">
          <mxCell parent="6xdwLMv3JOkRuOh6EPVC-1" style="swimlane;html=1;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=66;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=#FDF4FF;whiteSpace=wrap;spacingTop=24;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;fontFamily=Recursive;strokeWidth=2;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" vertex="1">
