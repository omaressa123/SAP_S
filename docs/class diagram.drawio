        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass User {\n  -Long id PK\n  -String fullName\n  -String email UNIQUE\n  -String passwordHash\n  -String role\n  -String status\n  +login() boolean\n  +logout() void\n  +changePwd(String pwd) boolean\n}\nclass Passenger {\n  -Long userId PK_FK\n  -String nationality\n  -LocalDate dateOfBirth\n  -Boolean biometricConsent\n  -Boolean needsStepFree\n  +verifyIdentity() boolean\n  +getBookings() List\n}\nclass Staff {\n  -Long userId PK_FK\n  -String employeeId UNIQUE\n  -String department\n  -String jobRole\n  -String shift\n  +getAssignedTasks() List\n  +handleCase(Long caseId) void\n}\nclass Passport {\n  -Long passportId PK\n  -String number UNIQUE\n  -String issuingCountry\n  -LocalDate expiryDate\n  -Long passengerId FK\n  +isExpired() boolean\n  +matchesBooking(Long id) boolean\n}\nclass FaceTemplate {\n  -Long faceId PK\n  -String encodedData\n  -LocalDateTime createdAt\n  -LocalDateTime expiresAt\n  -Long passengerId FK\n  +compare(String liveFace) Double\n  +purge() void\n}\nclass Booking {\n  -Long bookingId PK\n  -String bookingRef UNIQUE\n  -String seatNumber\n  -String checkInStatus\n  -Long passengerId FK\n  -Long flightId FK\n  +checkIn() BoardingPass\n  +cancel() void\n}\nclass CheckInRecord {\n  -Long checkInId PK\n  -String status\n  -Double faceMatchScore\n  -LocalDateTime completedAt\n  -Long bookingId FK\n  -Long passportId FK\n  +verifyIdentity() boolean\n  +complete() BoardingPass\n  +escalateToStaff() void\n}\nclass BoardingPass {\n  -Long passId PK\n  -String qrCode\n  -LocalDateTime issuedAt\n  -String status\n  -Long bookingId FK\n  +validate() boolean\n  +markBoarded() void\n}\nclass Baggage {\n  -Long bagId PK\n  -String tagCode UNIQUE\n  -Double weightKg\n  -String status\n  -String lastLocation\n  -Long bookingId FK\n  +updateStatus(String s) void\n  +track() String\n}\nclass ScreeningResult {\n  -Long screeningId PK\n  -String decision\n  -Double aiConfidence\n  -LocalDateTime screenedAt\n  -Long bagId FK\n  -Long officerId FK\n  +flagForInspection() void\n  +clear() void\n  +escalate() void\n}\nclass Flight {\n  -Long flightId PK\n  -String flightNumber UNIQUE\n  -String destination\n  -LocalDateTime departureTime\n  -String status\n  -Long gateId FK\n  +updateStatus(String status) void\n  +assignGate(Long gateId) void\n  +isBoardingOpen() boolean\n}\nclass Gate {\n  -Long gateId PK\n  -String code\n  -String status\n  -Boolean isSmartGate\n  -Long terminalId FK\n  +open() void\n  +isAvailable() boolean\n}\nclass Terminal {\n  -Long terminalId PK\n  -String name\n  -Integer floors\n  -String status\n  +getGates() List\n  +getDeviceCount() int\n}\nclass IoTDevice {\n  -Long deviceId PK\n  -String type\n  -String location\n  -String status\n  -LocalDateTime lastUpdate\n  -Long terminalId FK\n  +reportStatus() String\n  +sendData() SensorData\n}\nclass SmartGate {\n  -Long deviceId PK_FK\n  -Long gateId FK\n  -String mode\n  -LocalDateTime lastScanAt\n  -Integer boardedCount\n  +verifyBoarding(String qr) boolean\n  +open() void\n  +close() void\n}\nclass SensorData {\n  -Long dataId PK\n  -Double value\n  -String unit\n  -LocalDateTime recordedAt\n  -Long deviceId FK\n  +isAbnormal() boolean\n  +getLatest() SensorData\n}\nclass SecurityIncident {\n  -Long incidentId PK\n  -String type\n  -String status\n  -LocalDateTime detectedAt\n  -Long deviceId FK\n  -Long staffId FK\n  +assignStaff(Long staffId) void\n  +close(String report) void\n}\nclass MaintenanceTicket {\n  -Long ticketId PK\n  -String symptom\n  -String priority\n  -String status\n  -Long deviceId FK\n  -Long technicianId FK\n  +assign(Long staffId) void\n  +escalate() void\n  +close(String notes) void\n}\n\nUser &lt;|-- Passenger\nUser &lt;|-- Staff\nIoTDevice &lt;|-- SmartGate\n\nPassenger \&quot;1\&quot; *-- \&quot;0..1\&quot; FaceTemplate : has\nPassenger \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Passport : owns\nPassenger \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Booking : makes\n\nBooking \&quot;1\&quot; --&gt; \&quot;0..1\&quot; CheckInRecord : checked in by\nPassport \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CheckInRecord : used in\nBooking \&quot;1\&quot; *-- \&quot;0..1\&quot; BoardingPass : issues\nBooking \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Baggage : carries\nBooking \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Flight : is for\n\nBaggage \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; ScreeningResult : checked\nStaff \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ScreeningResult : decides\nStaff \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; SecurityIncident : handles\nStaff \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; MaintenanceTicket : fixes\n\nFlight \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Gate : uses\nTerminal \&quot;1\&quot; *-- \&quot;1..*\&quot; Gate : part of\nGate \&quot;1\&quot; --&gt; \&quot;0..1\&quot; SmartGate : equipped\n\nTerminal \&quot;1\&quot; o-- \&quot;0..*\&quot; IoTDevice : hosts\nIoTDevice \&quot;1\&quot; *-- \&quot;0..*\&quot; SensorData : emits\nIoTDevice \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; SecurityIncident : detects\nIoTDevice \&quot;1\&quot; --&gt; \&quot;0..*\&quot; MaintenanceTicket : has\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="_aQhRbWp9fcs0hiw2I5g-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
