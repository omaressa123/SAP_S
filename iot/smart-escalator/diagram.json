{
  "version": 1,
  "author": "Airport IoT Team",
  "editor": "wokwi",
  "serialMonitor": {
    "display": "always"
  },
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd1",
      "top": -170,
      "left": 220,
      "attrs": {
        "pins": "i2c"
      }
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir1",
      "top": -190,
      "left": -300,
      "attrs": {}
    },
    {
      "type": "wokwi-slide-switch",
      "id": "sw_dir",
      "top": -80,
      "left": -300,
      "attrs": {}
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_estop",
      "top": 0,
      "left": -300,
      "attrs": {
        "color": "red",
        "label": "STOP"
      }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_cur",
      "top": 0,
      "left": 230,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led_run",
      "top": 120,
      "left": -290,
      "attrs": {
        "color": "green",
        "label": "RUN"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led_slow",
      "top": 120,
      "left": -240,
      "attrs": {
        "color": "yellow",
        "label": "SLOW"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led_stop",
      "top": 120,
      "left": -190,
      "attrs": {
        "color": "red",
        "label": "STOP"
      }
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": 110,
      "left": 230,
      "attrs": {}
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "gas1:GND", "gnd1:GND", "black", [ "h0" ] ],
    [
      "lcd1:GND",
      "esp:GND.2",
      "green",
      []
    ],
    [
      "lcd1:VCC",
      "esp:5V",
      "green",
      []
    ],
    [
      "lcd1:SDA",
      "esp:21",
      "green",
      []
    ],
    [
      "lcd1:SCL",
      "esp:22",
      "green",
      []
    ],
    [
      "pir1:VCC",
      "esp:5V",
      "green",
      []
    ],
    [
      "pir1:GND",
      "esp:GND.1",
      "green",
      []
    ],
    [
      "pir1:OUT",
      "esp:27",
      "green",
      []
    ],
    [
      "sw_dir:2",
      "esp:26",
      "green",
      []
    ],
    [
      "sw_dir:1",
      "esp:GND.1",
      "green",
      []
    ],
    [
      "btn_estop:1.l",
      "esp:25",
      "green",
      []
    ],
    [
      "btn_estop:2.l",
      "esp:GND.1",
      "green",
      []
    ],
    [
      "pot_cur:GND",
      "esp:GND.2",
      "green",
      []
    ],
    [
      "pot_cur:VCC",
      "esp:3V3",
      "green",
      []
    ],
    [
      "pot_cur:SIG",
      "esp:34",
      "green",
      []
    ],
    [
      "led_run:A",
      "esp:16",
      "green",
      []
    ],
    [
      "led_run:C",
      "esp:GND.1",
      "green",
      []
    ],
    [
      "led_slow:A",
      "esp:17",
      "green",
      []
    ],
    [
      "led_slow:C",
      "esp:GND.1",
      "green",
      []
    ],
    [
      "led_stop:A",
      "esp:18",
      "green",
      []
    ],
    [
      "led_stop:C",
      "esp:GND.1",
      "green",
      []
    ],
    [
      "bz1:1",
      "esp:GND.2",
      "green",
      []
    ],
    [
      "bz1:2",
      "esp:23",
      "green",
      []
    ]
  ],
  "dependencies": {}
}