{
  "version": 1,
  "author": "Airport IoT Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_smoke", "top": -120, "left": 160, "attrs": { "label": "Smoke ppm" } },
    { "type": "wokwi-potentiometer", "id": "pot_temp", "top": -220, "left": 160, "attrs": { "label": "Temp C" } },
    { "type": "wokwi-led", "id": "led_ok", "top": -60, "left": -80, "attrs": { "color": "green", "label": "CLEAR" } },
    { "type": "wokwi-led", "id": "led_warn", "top": -60, "left": -140, "attrs": { "color": "yellow", "label": "WARNING" } },
    { "type": "wokwi-led", "id": "led_crit", "top": -120, "left": -110, "attrs": { "color": "red", "label": "CRITICAL" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": -120, "left": -60, "attrs": { "volume": "0.2" } },
    { "type": "wokwi-pushbutton", "id": "btn_test", "top": 120, "left": -180, "attrs": { "color": "yellow", "label": "1. Test Alarm" } },
    { "type": "wokwi-pushbutton", "id": "btn_silence", "top": 120, "left": -60, "attrs": { "color": "blue", "label": "2. Silence" } },
    { "type": "wokwi-pushbutton", "id": "btn_reset", "top": 200, "left": -120, "attrs": { "color": "grey", "label": "3. Reset" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -20, "left": -80, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": -20, "left": -140, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": -80, "left": -110, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$if:serial:RX", "", [] ],
    [ "esp:RX", "$if:serial:TX", "", [] ],
    [ "esp:34", "pot_smoke:SIG", "blue", [ "h:0" ] ],
    [ "pot_smoke:VCC", "esp:3V3", "red", [ "h:0" ] ],
    [ "pot_smoke:GND", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:35", "pot_temp:SIG", "green", [ "h:0" ] ],
    [ "pot_temp:VCC", "esp:3V3", "red", [ "h:0" ] ],
    [ "pot_temp:GND", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:2", "r1:1", "green", [ "h:0" ] ],
    [ "r1:2", "led_ok:A", "green", [ "h:0" ] ],
    [ "led_ok:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:4", "r2:1", "yellow", [ "h:0" ] ],
    [ "r2:2", "led_warn:A", "yellow", [ "h:0" ] ],
    [ "led_warn:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:5", "r3:1", "red", [ "h:0" ] ],
    [ "r3:2", "led_crit:A", "red", [ "h:0" ] ],
    [ "led_crit:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:18", "buzzer:2", "purple", [ "h:0" ] ],
    [ "buzzer:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:19", "btn_test:2.1", "yellow", [ "h:0" ] ],
    [ "btn_test:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:21", "btn_silence:2.1", "blue", [ "h:0" ] ],
    [ "btn_silence:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:23", "btn_reset:2.1", "grey", [ "h:0" ] ],
    [ "btn_reset:1.1", "esp:GND.2", "black", [ "h:0" ] ]
  ],
  "dependencies": {}
}
