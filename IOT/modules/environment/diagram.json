{
  "version": 1,
  "author": "Airport IoT Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_temp", "top": -120, "left": 160, "attrs": { "label": "Temp C" } },
    { "type": "wokwi-potentiometer", "id": "pot_hum", "top": -220, "left": 160, "attrs": { "label": "Humidity" } },
    { "type": "wokwi-potentiometer", "id": "pot_co2", "top": -320, "left": 160, "attrs": { "label": "CO2 ppm" } },
    { "type": "wokwi-led", "id": "led_ok", "top": -60, "left": -80, "attrs": { "color": "green", "label": "COMFORT OK" } },
    { "type": "wokwi-led", "id": "led_warn", "top": -60, "left": -140, "attrs": { "color": "yellow", "label": "WARNING" } },
    { "type": "wokwi-led", "id": "led_poor", "top": -120, "left": -110, "attrs": { "color": "red", "label": "POOR AIR" } },
    { "type": "wokwi-relay-module", "id": "fan", "top": -120, "left": -60, "attrs": { "label": "Fan" } },
    { "type": "wokwi-pushbutton", "id": "btn_fan", "top": 120, "left": -180, "attrs": { "color": "blue", "label": "1. Fan Override" } },
    { "type": "wokwi-pushbutton", "id": "btn_reset", "top": 120, "left": -60, "attrs": { "color": "grey", "label": "2. Reset/Auto" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -20, "left": -80, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": -20, "left": -140, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": -80, "left": -110, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$if:serial:RX", "", [] ],
    [ "esp:RX", "$if:serial:TX", "", [] ],
    [ "esp:34", "pot_temp:SIG", "blue", [ "h:0" ] ],
    [ "pot_temp:VCC", "esp:3V3", "red", [ "h:0" ] ],
    [ "pot_temp:GND", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:35", "pot_hum:SIG", "green", [ "h:0" ] ],
    [ "pot_hum:VCC", "esp:3V3", "red", [ "h:0" ] ],
    [ "pot_hum:GND", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:32", "pot_co2:SIG", "orange", [ "h:0" ] ],
    [ "pot_co2:VCC", "esp:3V3", "red", [ "h:0" ] ],
    [ "pot_co2:GND", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:2", "r1:1", "green", [ "h:0" ] ],
    [ "r1:2", "led_ok:A", "green", [ "h:0" ] ],
    [ "led_ok:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:4", "r2:1", "yellow", [ "h:0" ] ],
    [ "r2:2", "led_warn:A", "yellow", [ "h:0" ] ],
    [ "led_warn:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:5", "r3:1", "red", [ "h:0" ] ],
    [ "r3:2", "led_poor:A", "red", [ "h:0" ] ],
    [ "led_poor:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:18", "fan:IN", "purple", [ "h:0" ] ],
    [ "esp:GND.1", "fan:GND", "black", [ "h:0" ] ],
    [ "esp:5V", "fan:VCC", "red", [ "h:0" ] ],
    [ "esp:19", "btn_fan:2.1", "blue", [ "h:0" ] ],
    [ "btn_fan:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:23", "btn_reset:2.1", "grey", [ "h:0" ] ],
    [ "btn_reset:1.1", "esp:GND.2", "black", [ "h:0" ] ]
  ],
  "dependencies": {}
}
