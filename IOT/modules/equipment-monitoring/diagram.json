{
  "version": 1,
  "author": "Airport IoT Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_temp", "top": -90, "left": 180, "attrs": { "label": "Temperature sim (20-110C)" } },
    { "type": "wokwi-potentiometer", "id": "pot_vib", "top": 10, "left": 180, "attrs": { "label": "Vibration sim (0-10mm/s)" } },
    { "type": "wokwi-potentiometer", "id": "pot_curr", "top": 110, "left": 180, "attrs": { "label": "Current sim (0-20A)" } },
    { "type": "wokwi-led", "id": "led_run", "top": -60, "left": -80, "attrs": { "color": "green", "label": "RUNNING" } },
    { "type": "wokwi-led", "id": "led_warn", "top": -60, "left": -140, "attrs": { "color": "yellow", "label": "WARNING" } },
    { "type": "wokwi-led", "id": "led_crit", "top": -60, "left": -200, "attrs": { "color": "red", "label": "CRITICAL" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": -120, "left": -60, "attrs": { "volume": "0.2" } },
    { "type": "wokwi-pushbutton", "id": "btn_run", "top": 160, "left": -180, "attrs": { "color": "green", "label": "1. Start/Stop Equipment" } },
    { "type": "wokwi-pushbutton", "id": "btn_maint", "top": 160, "left": -60, "attrs": { "color": "yellow", "label": "2. Maintenance" } },
    { "type": "wokwi-pushbutton", "id": "btn_reset", "top": 240, "left": -120, "attrs": { "color": "grey", "label": "3. Reset" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -20, "left": -80, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": -20, "left": -140, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": -20, "left": -200, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$if:serial:RX", "", [] ],
    [ "esp:RX", "$if:serial:TX", "", [] ],
    [ "esp:2", "r1:1", "green", [ "h:0" ] ],
    [ "r1:2", "led_run:A", "green", [ "h:0" ] ],
    [ "led_run:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:4", "r2:1", "yellow", [ "h:0" ] ],
    [ "r2:2", "led_warn:A", "yellow", [ "h:0" ] ],
    [ "led_warn:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:5", "r3:1", "red", [ "h:0" ] ],
    [ "r3:2", "led_crit:A", "red", [ "h:0" ] ],
    [ "led_crit:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:18", "buzzer:2", "purple", [ "h:0" ] ],
    [ "buzzer:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:19", "btn_run:2.1", "green", [ "h:0" ] ],
    [ "btn_run:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:21", "btn_maint:2.1", "yellow", [ "h:0" ] ],
    [ "btn_maint:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:23", "btn_reset:2.1", "grey", [ "h:0" ] ],
    [ "btn_reset:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "pot_temp:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "pot_temp:3", "esp:3V3", "red", [ "h:0" ] ],
    [ "esp:34", "pot_temp:2", "green", [ "h:0" ] ],
    [ "pot_vib:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "pot_vib:3", "esp:3V3", "red", [ "h:0" ] ],
    [ "esp:35", "pot_vib:2", "green", [ "h:0" ] ],
    [ "pot_curr:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "pot_curr:3", "esp:3V3", "red", [ "h:0" ] ],
    [ "esp:32", "pot_curr:2", "green", [ "h:0" ] ]
  ],
  "dependencies": {}
}
