{
  "version": 1,
  "author": "Airport IoT Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-servo", "id": "servo1", "top": -120, "left": 160, "attrs": {} },
    { "type": "wokwi-led", "id": "led_green", "top": -60, "left": -80, "attrs": { "color": "green", "label": "DOOR OPEN" } },
    { "type": "wokwi-led", "id": "led_red", "top": -60, "left": -140, "attrs": { "color": "red", "label": "MOVING/ALARM" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": -120, "left": -60, "attrs": { "volume": "0.2" } },
    { "type": "wokwi-pushbutton", "id": "btn_up", "top": 120, "left": -180, "attrs": { "color": "blue", "label": "1. Call Up" } },
    { "type": "wokwi-pushbutton", "id": "btn_down", "top": 120, "left": -60, "attrs": { "color": "blue", "label": "2. Call Down" } },
    { "type": "wokwi-pushbutton", "id": "btn_overload", "top": 200, "left": -60, "attrs": { "color": "yellow", "label": "3. Overload" } },
    { "type": "wokwi-pushbutton", "id": "btn_estop", "top": 200, "left": -180, "attrs": { "color": "red", "label": "4. E-STOP" } },
    { "type": "wokwi-pushbutton", "id": "btn_reset", "top": 280, "left": -120, "attrs": { "color": "grey", "label": "5. Reset" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -20, "left": -80, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": -20, "left": -140, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$if:serial:RX", "", [] ],
    [ "esp:RX", "$if:serial:TX", "", [] ],
    [ "esp:GND.1", "servo1:GND", "black", [ "h:0" ] ],
    [ "esp:5V", "servo1:V+", "red", [ "h:0" ] ],
    [ "esp:18", "servo1:PWM", "orange", [ "h:0" ] ],
    [ "esp:2", "r1:1", "green", [ "h:0" ] ],
    [ "r1:2", "led_green:A", "green", [ "h:0" ] ],
    [ "led_green:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:4", "r2:1", "red", [ "h:0" ] ],
    [ "r2:2", "led_red:A", "red", [ "h:0" ] ],
    [ "led_red:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:5", "buzzer:2", "purple", [ "h:0" ] ],
    [ "buzzer:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:19", "btn_up:2.1", "blue", [ "h:0" ] ],
    [ "btn_up:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:21", "btn_down:2.1", "blue", [ "h:0" ] ],
    [ "btn_down:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:22", "btn_overload:2.1", "yellow", [ "h:0" ] ],
    [ "btn_overload:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:25", "btn_estop:2.1", "red", [ "h:0" ] ],
    [ "btn_estop:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:23", "btn_reset:2.1", "grey", [ "h:0" ] ],
    [ "btn_reset:1.1", "esp:GND.2", "black", [ "h:0" ] ]
  ],
  "dependencies": {}
}
