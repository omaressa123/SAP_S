{
  "version": 1,
  "author": "Airport IoT Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_volt", "top": -90, "left": 180, "attrs": { "label": "Voltage sim (360-440V)" } },
    { "type": "wokwi-potentiometer", "id": "pot_curr", "top": 10, "left": 180, "attrs": { "label": "Current demand sim (0-125A)" } },
    { "type": "wokwi-potentiometer", "id": "pot_temp", "top": 110, "left": 180, "attrs": { "label": "Temperature sim (20-80C)" } },
    { "type": "wokwi-led", "id": "led_avail", "top": -60, "left": -80, "attrs": { "color": "green", "label": "AVAILABLE / COMPLETE" } },
    { "type": "wokwi-led", "id": "led_chg", "top": -60, "left": -140, "attrs": { "color": "yellow", "label": "CHARGING" } },
    { "type": "wokwi-led", "id": "led_alarm", "top": -60, "left": -200, "attrs": { "color": "red", "label": "FAULT / ALARM" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": -120, "left": -60, "attrs": { "volume": "0.2" } },
    { "type": "wokwi-relay-module", "id": "relay", "top": -140, "left": 100, "attrs": { "label": "Contactor (sim)" } },
    { "type": "wokwi-pushbutton", "id": "btn_connect", "top": 160, "left": -200, "attrs": { "color": "blue", "label": "1. Connect/Disconnect Vehicle" } },
    { "type": "wokwi-pushbutton", "id": "btn_start", "top": 160, "left": -80, "attrs": { "color": "green", "label": "2. Start/Stop Charging" } },
    { "type": "wokwi-pushbutton", "id": "btn_estop", "top": 240, "left": -200, "attrs": { "color": "red", "label": "3. EMERGENCY STOP" } },
    { "type": "wokwi-pushbutton", "id": "btn_reset", "top": 240, "left": -80, "attrs": { "color": "grey", "label": "4. Reset" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -20, "left": -80, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": -20, "left": -140, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": -20, "left": -200, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$if:serial:RX", "", [] ],
    [ "esp:RX", "$if:serial:TX", "", [] ],
    [ "esp:2", "r1:1", "green", [ "h:0" ] ],
    [ "r1:2", "led_avail:A", "green", [ "h:0" ] ],
    [ "led_avail:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:4", "r2:1", "yellow", [ "h:0" ] ],
    [ "r2:2", "led_chg:A", "yellow", [ "h:0" ] ],
    [ "led_chg:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:5", "r3:1", "red", [ "h:0" ] ],
    [ "r3:2", "led_alarm:A", "red", [ "h:0" ] ],
    [ "led_alarm:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:13", "buzzer:2", "purple", [ "h:0" ] ],
    [ "buzzer:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:18", "relay:IN", "orange", [ "h:0" ] ],
    [ "relay:VCC", "esp:5V", "red", [ "h:0" ] ],
    [ "relay:GND", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:19", "btn_connect:2.1", "blue", [ "h:0" ] ],
    [ "btn_connect:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:21", "btn_start:2.1", "green", [ "h:0" ] ],
    [ "btn_start:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:25", "btn_estop:2.1", "red", [ "h:0" ] ],
    [ "btn_estop:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:23", "btn_reset:2.1", "grey", [ "h:0" ] ],
    [ "btn_reset:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "pot_volt:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "pot_volt:3", "esp:3V3", "red", [ "h:0" ] ],
    [ "esp:34", "pot_volt:2", "green", [ "h:0" ] ],
    [ "pot_curr:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "pot_curr:3", "esp:3V3", "red", [ "h:0" ] ],
    [ "esp:35", "pot_curr:2", "green", [ "h:0" ] ],
    [ "pot_temp:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "pot_temp:3", "esp:3V3", "red", [ "h:0" ] ],
    [ "esp:32", "pot_temp:2", "green", [ "h:0" ] ]
  ],
  "dependencies": {}
}
