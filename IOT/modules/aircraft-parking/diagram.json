{
  "version": 1,
  "author": "Airport IoT Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_front", "top": -80, "left": 180, "attrs": { "label": "FRONT proximity (distance sim)" } },
    { "type": "wokwi-potentiometer", "id": "pot_side", "top": 20, "left": 180, "attrs": { "label": "SIDE proximity (distance sim)" } },
    { "type": "wokwi-servo", "id": "servo1", "top": -140, "left": 120, "attrs": {} },
    { "type": "wokwi-led", "id": "led_green", "top": -60, "left": -80, "attrs": { "color": "green", "label": "PARKED" } },
    { "type": "wokwi-led", "id": "led_yellow", "top": -60, "left": -140, "attrs": { "color": "yellow", "label": "APPROACH / ALIGN" } },
    { "type": "wokwi-led", "id": "led_red", "top": -60, "left": -200, "attrs": { "color": "red", "label": "UNSAFE / WARNING" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": -120, "left": -60, "attrs": { "volume": "0.2" } },
    { "type": "wokwi-pushbutton", "id": "btn_arrival", "top": 160, "left": -180, "attrs": { "color": "blue", "label": "1. Aircraft Arrival" } },
    { "type": "wokwi-pushbutton", "id": "btn_depart", "top": 160, "left": -60, "attrs": { "color": "yellow", "label": "2. Aircraft Departure" } },
    { "type": "wokwi-pushbutton", "id": "btn_reset", "top": 240, "left": -120, "attrs": { "color": "grey", "label": "3. Reset Stand" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -20, "left": -80, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": -20, "left": -140, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": -20, "left": -200, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$if:serial:RX", "", [] ],
    [ "esp:RX", "$if:serial:TX", "", [] ],
    [ "esp:GND.1", "servo1:GND", "black", [ "h:0" ] ],
    [ "esp:5V", "servo1:V+", "red", [ "h:0" ] ],
    [ "esp:22", "servo1:PWM", "orange", [ "h:0" ] ],
    [ "esp:2", "r1:1", "green", [ "h:0" ] ],
    [ "r1:2", "led_green:A", "green", [ "h:0" ] ],
    [ "led_green:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:4", "r2:1", "yellow", [ "h:0" ] ],
    [ "r2:2", "led_yellow:A", "yellow", [ "h:0" ] ],
    [ "led_yellow:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:5", "r3:1", "red", [ "h:0" ] ],
    [ "r3:2", "led_red:A", "red", [ "h:0" ] ],
    [ "led_red:C", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:18", "buzzer:2", "purple", [ "h:0" ] ],
    [ "buzzer:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "esp:19", "btn_arrival:2.1", "blue", [ "h:0" ] ],
    [ "btn_arrival:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:21", "btn_depart:2.1", "yellow", [ "h:0" ] ],
    [ "btn_depart:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "esp:23", "btn_reset:2.1", "grey", [ "h:0" ] ],
    [ "btn_reset:1.1", "esp:GND.2", "black", [ "h:0" ] ],
    [ "pot_front:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "pot_front:3", "esp:3V3", "red", [ "h:0" ] ],
    [ "esp:34", "pot_front:2", "green", [ "h:0" ] ],
    [ "pot_side:1", "esp:GND.1", "black", [ "h:0" ] ],
    [ "pot_side:3", "esp:3V3", "red", [ "h:0" ] ],
    [ "esp:35", "pot_side:2", "green", [ "h:0" ] ]
  ],
  "dependencies": {}
}
